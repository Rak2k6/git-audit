# Copy this file to .env and fill in your values.
# The backend reads all variables from the environment at startup.

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY="YOUR API KEY HERE"

# ── Optional: Redis cache ─────────────────────────────────────────────────────
# If Redis is not running, the pipeline continues without caching.
# REDIS_URL="redis://localhost:6379"

# ── Pipeline tuning (safe to leave as defaults) ───────────────────────────────
# MAX_SINGLE_ANALYSIS=6000       # tokens — threshold for single vs. chunked path
# MODEL_CONTEXT_WINDOW=8192      # tokens — llama-3.3-70b context window
# PROMPT_OVERHEAD_TOKENS=1200    # tokens consumed by system prompt scaffolding
# SAFETY_MARGIN_TOKENS=500       # buffer below context limit
# CHUNK_OVERLAP=200              # token overlap between consecutive chunks
# MAX_CONCURRENT_CHUNKS=5        # Semaphore limit for parallel Auditor calls
# MAX_CHUNK_RETRIES=2            # retries per failed chunk (exponential backoff)
# RETRY_BASE_DELAY_SEC=1.0       # base delay for 1s → 2s → 4s backoff

# ── Semantic deduplication ────────────────────────────────────────────────────
# ENABLE_SEMANTIC_DEDUP=true     # set false to use string-based dedup (no model download)
# SIMILARITY_THRESHOLD=0.85      # cosine similarity above which clauses are merged

# ── Cost tracking ─────────────────────────────────────────────────────────────
# COST_PER_1K_TOKENS_USD=0.00059  # Groq llama-3.3-70b approximate price
